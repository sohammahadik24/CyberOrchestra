# Environment Configuration for CyberOrchestra Backend
# (Do not place real API keys in this template file)

# Malware Analysis Agent LLM profile via the shared LLM service
MALWARE_LLM_PROVIDER=groq
MALWARE_LLM_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=

# Threat Detection Agent LLM profile via the shared LLM service
THREAT_LLM_PROVIDER=groq
THREAT_LLM_MODEL=openai/gpt-oss-120b

# Log Analysis Agent LLM profile via the shared LLM service
LOG_LLM_PROVIDER=groq
LOG_LLM_MODEL=qwen/qwen3-32b
GROQ_LOG_MODEL=

# Threat Intelligence Integrations
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=

# NVD CVE API 2.0 Configuration
# NVD_API_KEY is OPTIONAL. The NVD API works without a key at a lower rate limit.
# Register for a free key at: https://nvd.nist.gov/developers/request-an-api-key
# With key: ~50 requests/30s | Without key: ~5 requests/30s
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# Vulnerability Assessment Agent LLM profile via the shared LLM service
VULNERABILITY_LLM_PROVIDER=groq
VULNERABILITY_LLM_MODEL=qwen/qwen3-32b

# Recovery Planning Agent LLM profile via the shared LLM service
RECOVERY_LLM_PROVIDER=groq
RECOVERY_LLM_MODEL=qwen/qwen3-32b

# Report Generation Agent LLM profile via the shared LLM service
REPORT_LLM_PROVIDER=groq
REPORT_LLM_MODEL=qwen/qwen3-32b

# Single-LLM baseline profile, isolated from the multi-agent pipeline
BASELINE_LLM_PROVIDER=groq
BASELINE_LLM_MODEL=openai/gpt-oss-120b
